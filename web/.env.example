# =============================================================================
# Orbit — variables d'environnement (copier en .env.local ; ne JAMAIS committer de vraies valeurs)
# Vercel : Project Settings › Environment Variables (Production + Preview).
# =============================================================================

# --- Source de données -------------------------------------------------------
# demo     : données fictives sans base (src/lib/db/demo/fixture.json), choix du profil sur /login
# supabase : base Supabase (défaut dès que l'URL et la clé anon sont renseignées)
# ORBIT_DATA_SOURCE=demo

# --- Supabase (Project Settings › API) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne la RLS : serveur uniquement (cron, invitations, jetons). Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta (developers.facebook.com › votre app) ---------------------------------
META_APP_ID=1452532180348433
# Serveur uniquement.
META_APP_SECRET=
# Facebook Login for Business › Configurations
META_CONFIG_ID=1043988088713323
META_API_VERSION=v25.0
# URI de redirection OAuth à déclarer dans l'app Meta (Facebook Login for Business › Paramètres) :
#   ${APP_URL}/api/meta/callback   (ex. http://localhost:3000/api/meta/callback, https://<domaine-vercel>/api/meta/callback)

# --- Sécurité ---------------------------------------------------------------------
# Clé AES-256-GCM des jetons d'accès en base : 32 octets en base64 → `openssl rand -base64 32`
# La changer rend les jetons existants illisibles (reconnexion des comptes nécessaire).
TOKEN_ENCRYPTION_KEY=
# Secret des routes /api/cron/* (Vercel l'envoie en « Authorization: Bearer … ») → `openssl rand -hex 32`
CRON_SECRET=

# --- E-mails (rapports programmés) ---------------------------------------------
# Absente : les envois programmés sont journalisés mais pas envoyés.
RESEND_API_KEY=
# Expéditeur des rapports (domaine vérifié dans Resend)
REPORTS_FROM_EMAIL="Orbit <rapports@votre-agence.fr>"

# --- Application ------------------------------------------------------------------
# URL publique (liens magiques, liens dans les e-mails). Local : http://localhost:3000
APP_URL=http://localhost:3000
